# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional overrides
# MODEL_PATH=models/yolox_nano.onnx
# CONF_THRESHOLD=0.4
# MAX_UPLOAD_MB=200

# Incident DB / demo / monitoring (optional)
# SAFESIGHT_DB=data/safesight.db
# SAFESIGHT_DEMO=1
# Event output (JSON lines always; MQTT when a host is set; needs `pip install paho-mqtt`)
# SAFESIGHT_MQTT_HOST=localhost
# SAFESIGHT_MQTT_PORT=1883
# SAFESIGHT_MQTT_PREFIX=safesight
# SAFESIGHT_EVENTS_JSONL=data/events.jsonl
